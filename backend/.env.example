# ------------------------------------------------------------------
# VR Enterprises API — environment example
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5176
# Comma-separated extra allowed origins (the public website origin).
CORS_ORIGINS=http://localhost:5176
# Set to "true" only when behind a trusted reverse proxy (nginx, etc.).
TRUST_PROXY=false
LOG_LEVEL=info

# Database
#   DB_CLIENT: postgres | sqlite | auto (default)
#     auto -> SQLite when DATABASE_URL starts with file:/sqlite:, otherwise
#             PostgreSQL when set, or embedded SQLite when unset.
#
# SQLite (embedded SQL, zero setup — works immediately):
DB_CLIENT=sqlite
DATABASE_URL=file:./storage/vr.sqlite
#
# PostgreSQL (managed/hosted or local server):
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/vr_enterprises
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Sessions / CSRF (production requires >= 32 chars each)
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
CSRF_SECRET=replace-with-a-different-long-random-string-32-chars
SESSION_TTL_HOURS=12
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Email delivery: smtp | console | none
# In production a real provider (smtp) is required or the API refuses to start.
EMAIL_PROVIDER=console
EMAIL_FROM=VR Enterprises <no-reply@thevrenterprises.com>
EMAIL_TO=sales@thevrenterprises.com
EMAIL_CC=vrenterprises.nm@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Uploads
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
RATE_LIMIT_ADMIN_MAX=300

# CAPTCHA (optional; server-side support is wired but disabled by default)
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET=

# Careers: only real openings go here (comma-separated). Left empty, the site
# offers a "General Application" only.
CAREER_POSITIONS=
