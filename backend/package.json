{
  "name": "vr-enterprises-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready backend API for the VR Enterprises website (contact, quote, careers, admin).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.js",
    "admin:create": "node src/cli/create-admin.js",
    "test": "node --test --test-concurrency=1 test/",
    "test:watch": "node --test --watch test/",
    "lint": "oxlint src test public",
    "opencode": "opencode-ai"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5",
    "opencode-ai": "^1.19.0",
    "oxlint": "^1.81.0",
    "supertest": "^7.1.4"
  }
}
