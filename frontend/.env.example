# Frontend environment variables (Vite).
#
# Base URL of the VR Enterprises API (backend). During local development this
# is where `npm run dev` runs in /backend. In production, point this at the
# public API origin, or set it to an empty value to serve the API from the same
# origin (e.g. behind a reverse proxy that routes /api to the backend).
VITE_API_URL=http://localhost:8787
